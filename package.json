{
  "name": "gymbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm dlx vercel dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:golden": "vitest run --project golden",
    "plan:parse": "tsx scripts/plan-parse.ts",
    "plan:seed": "tsx scripts/plan-seed.ts",
    "progression:worksheet": "tsx scripts/progression-worksheet.ts",
    "history:review": "tsx scripts/history-import.ts --review",
    "history:import": "tsx scripts/history-import.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:up": "docker compose up -d db",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "check:setup": "tsx scripts/check-setup.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "demo:m0": "tsx scripts/demo-m0.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.18.0"
}
