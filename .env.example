# Supabase transaction pooler URI (port 6543). Used by the app at runtime.
DATABASE_URL=
# Supabase session pooler URI (port 5432). Used only for migrations.
MIGRATION_DATABASE_URL=
# Local Docker database for tests (pnpm db:up).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/gymbot_test
# Token from BotFather.
TELEGRAM_BOT_TOKEN=
# Random secret for the webhook header (openssl rand -hex 32).
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user ID. The bot ignores everyone else.
ALLOWED_TELEGRAM_USER_ID=
# Bearer secret for /api/health and cron endpoints (openssl rand -hex 32, min 32 chars).
CRON_SECRET=
# Anthropic API key.
ANTHROPIC_API_KEY=
# Claude model name.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Speech-to-text provider: groq or openai.
STT_PROVIDER=groq
# Groq API key (needed if STT_PROVIDER=groq).
GROQ_API_KEY=
# OpenAI API key (needed if STT_PROVIDER=openai).
OPENAI_API_KEY=
# Max AI tokens per day. Above this the bot replies "AI budget reached".
AI_DAILY_TOKEN_CAP=200000
# Max AI tokens per month.
AI_MONTHLY_TOKEN_CAP=3000000
